{
  "manifest_version": 3,
  "name": "Borderify",
  "version": "1.0",

  "description": "puts an upload button to toolbaruploadbutton",

  "icons": {
    "48": "icons/page-16.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "uploadbutton@mozilla.org",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["*://*.mozilla.org/*"],
      "js": ["borderify.js"]
    }
  ]
}